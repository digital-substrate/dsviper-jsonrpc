{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ESNext",
      "ESNext.Disposable"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "noErrorTruncation": true
  },
  "include": [
    "*.mjs",
    "../../clients/js/**/*.mjs",
    "../../tests/clients/js/**/*.mjs"
  ]
}
